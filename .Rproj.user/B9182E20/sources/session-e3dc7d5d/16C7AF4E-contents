### Implementación de la prueba de bondad de ajuste de uniformidad ######
### U ~ Unif(0, 1) ###

## Población
curve(dunif(x), -0.01, 1.01)
intervals <- seq(0, 1, 0.1)
pacum <- punif(intervals, 0, 1)
pi <- diff(pacum) # Parámetro a estimar
k <- length(pi)

# Muestra
muestra <- runif(100, 0, 1)
n <- length(muestra)
hist(muestra, probability = T, breaks = 10)
curve(dunif(x), add = T, col = "red")

library(fdth)
tfr <- fdt(muestra, start = 0, end = 1, h = 0.1)
pihat <- tfr$table$rf # Estimador de pi

est <- sum((((n*pihat) - (n*pi))^2) / (n*pi))
curve(dchisq(x, df = k - 1), 0, 30)
pval <- pchisq(q = est, df = k - 1, lower.tail = F)
est
pval

chisq.test(x = tfr$table$f, p = pi)

## Función propia
uniftest <- function(x){
  n <- length(x)
  pi <- rep(0.1, 10)
  k <- length(pi)
  tfr <- fdt(x, start = 0, end = 1, h = 0.1)
  pihat <- tfr$table$rf # Estimador de pi
  est <- sum((((n*pihat) - (n*pi))^2) / (n*pi))
  pval <- pchisq(q = est, df = k - 1, lower.tail = F)
  c("est" = est, "df" = k - 1, "p-val" = pval)
}

uniftest(muestra)
